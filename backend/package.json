{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug 9231 --port 3001 --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test:unit": "cross-env NODE_ENV=test jest --testRegex='.*\\.spec\\.ts$'",
    "test:unit:watch": "cross-env NODE_ENV=test jest --testRegex='.*\\.spec\\.ts$' --watch",
    "test:unit:debug": "cross-env NODE_ENV=test node --inspect -r tsconfig-paths/register -r ts-node/register ./node_modules/jest/bin/jest.js --testRegex='.*\\.spec\\.ts$' --runInBand",
    "test:integration": "cross-env NODE_ENV=test jest --config jest-e2e.config.js",
    "test:integration:watch": "cross-env NODE_ENV=test jest --config jest-e2e.config.js --watch",
    "test:integration:debug": "cross-env NODE_ENV=test node --inspect -r tsconfig-paths/register -r ts-node/register ./node_modules/jest/bin/jest.js --config jest-e2e.config.js --runInBand",
    "test:all": "npm run test:unit && npm run test:integration",
    "test:cov": "cross-env NODE_ENV=test jest --coverage",
    "test:cov:unit": "cross-env NODE_ENV=test jest --testRegex='.*\\.spec\\.ts$' --coverage"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/mongoose": "^11.0.3",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "mongoose": "^8.17.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/faker": "^5.5.9",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.17.0",
    "@types/passport": "^1.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.2",
    "cross-env": "^10.1.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "faker": "^5.5.3",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.20.0"
  }
}
