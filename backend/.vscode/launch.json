{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "🚀 Launch NestJS",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/.bin/nest",
      "args": [
        "start",
        "--debug",
        "9231",
        "--port",
        "3001",
        "--watch"
      ],
      "env": {
        "NODE_ENV": "development"
      },
      "restart": true,
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "skipFiles": [
        "<node_internals>/**"
      ],
      "windows": {
        "program": "${workspaceFolder}/node_modules/@nestjs/cli/bin/nest.js"
      }
    },
    {
      "name": "🧪 Debug Jest Unit",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/.bin/jest",
      "args": [
        "--testRegex='.*\\.spec\\.ts$'",
        "--runInBand",
        "--no-cache"
      ],
      "env": {
        "NODE_ENV": "test"
      },
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "windows": {
        "program": "${workspaceFolder}/node_modules/jest/bin/jest"
      },
      "skipFiles": [
        "<node_internals>/**",
        "**/node_modules/**"
      ]
    },
    {
      "name": "📡 Debug Jest Integration",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/.bin/jest",
      "args": [
        "--config",
        "jest-e2e.config.js",
        "--runInBand",
        "--no-cache"
      ],
      "env": {
        "NODE_ENV": "test"
      },
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "windows": {
        "program": "${workspaceFolder}/node_modules/jest/bin/jest"
      },
      "skipFiles": [
        "<node_internals>/**",
        "**/node_modules/**"
      ]
    }
  ]
}